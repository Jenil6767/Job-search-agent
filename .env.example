# General Runtime
NODE_ENV=development
PORT=5000
WEB_PORT=3000

# Database (MongoDB)
MONGODB_URI=mongodb://localhost:27017/ai_jobpilot

# Caching & BullMQ Queues (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Background Worker
WORKER_CONCURRENCY=5

# Authentication & Security
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_production_quality
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# AI Provider Configuration ('mock' | 'openai' | 'anthropic')
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest

# JSearch API (RapidAPI) — Job Ingestion
RAPIDAPI_KEY=
JSEARCH_HOST=jsearch.p.rapidapi.com
JSEARCH_MONTHLY_LIMIT=200
JSEARCH_DAILY_LIMIT=6

# Client Next.js Public Vars
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_APP_NAME="AI JobPilot"
